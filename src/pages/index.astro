---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.astro";
import Hero from "../components/Hero.astro";
import Method from "../components/Method.astro";
import Doctors from "../components/Doctors.astro";
import Specialties from "../components/Specialties.astro";
import WhatsAppButton from "../components/WhatsAppButton.astro";
import { clinic } from "../data/clinic.ts";
import { whatsappUrl } from "../data/validate.ts";

const ctaUrl = whatsappUrl(clinic);
---

<Base clinic={clinic}>
  <Nav clinic={clinic} />
  <main>
    <Hero
      hero={clinic.hero}
      brand={clinic.brand}
      rating={clinic.rating}
      ctaUrl={ctaUrl}
    />
    {clinic.method && <Method method={clinic.method} />}
    <Doctors doctors={clinic.doctors} title={clinic.titles.doctors} />
    <Specialties
      specialties={clinic.specialties}
      title={clinic.titles.specialties}
    />
  </main>
  <WhatsAppButton clinic={clinic} />
</Base>

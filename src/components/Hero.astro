---
import type { Brand, Hero, Rating } from "../data/types.ts";

interface Props {
  hero: Hero;
  brand: Brand;
  rating?: Rating;
  ctaUrl: string;
}

const { hero, brand, rating, ctaUrl } = Astro.props;
---

{/*
  Editorial hero, no photograph. There is no usable material of the clinic
  itself, and a page with little imagery and a lot of air reads as more
  expensive than one padded with stock.

  The rating sits beside the call to action rather than above the headline:
  proof belongs where the decision gets made, not floating over a title.
*/}
<section class="shell flex min-h-[78svh] flex-col justify-end pt-28 pb-14 md:min-h-[84svh] md:pt-36 md:pb-20">
  {/* One span per line: the reveal animates them in sequence, and the ragged
      right edge is the shape the sentence actually makes. Set large enough to
      fill the frame — at a modest size it stops being a graphic element and
      the page turns into text floating on white. */}
  <h1 class="font-display text-display">
    {hero.headline.map((line) => <span class="hero-line block">{line}</span>)}
  </h1>

  <p class="measure mt-8 text-lead text-ink-soft md:mt-10">{hero.subhead}</p>

  {/* The hero's bottom edge is composed as one full-width line rather than
      left as loose pieces: action and proof anchor the left, the clinic's
      own words close the right. */}
  <div class="mt-12 flex flex-col items-start gap-8 md:mt-16 md:flex-row md:items-center md:gap-12">
    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-11 w-full items-center justify-center rounded-full bg-accent px-8 py-4 font-medium text-accent-ink transition-opacity hover:opacity-90 md:w-auto"
    >
      {hero.cta}
    </a>

    {rating && (
      <p class="flex items-baseline gap-2 text-small text-ink-soft">
        <svg
          width="15"
          height="15"
          viewBox="0 0 24 24"
          fill="currentColor"
          aria-hidden="true"
          focusable="false"
          class="translate-y-px self-center text-accent"
        >
          <path
            d="M12 1.5l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 17.27l-6.18 3.25L7 13.63l-5-4.87 6.91-1L12 1.5Z"
          ></path>
        </svg>
        <span>
          <strong class="font-medium tabular-nums text-ink">{rating.score}</strong>
          {" "}de 5 en <span class="tabular-nums">{rating.count}</span> reseñas
          de {rating.source}{rating.updatedAgo && `, la más reciente ${rating.updatedAgo}`}.
        </span>
      </p>
    )}

    {/* The clinic signing its name before it shows its work. */}
    {brand.tagline && (
      <p class="text-small text-ink-soft md:ml-auto">{brand.tagline}</p>
    )}
  </div>
</section>

<style>
  /* The page's single orchestrated moment. Wrapped in no-preference so that
     reduced motion is the base state and the animation is what gets added,
     never the other way round. */
  @media (prefers-reduced-motion: no-preference) {
    .hero-line {
      animation: hero-rise 0.75s cubic-bezier(0.22, 0.68, 0.24, 1) backwards;
    }
    .hero-line:nth-child(1) {
      animation-delay: 0.04s;
    }
    .hero-line:nth-child(2) {
      animation-delay: 0.13s;
    }
    .hero-line:nth-child(3) {
      animation-delay: 0.22s;
    }

    @keyframes hero-rise {
      from {
        opacity: 0;
        transform: translateY(0.36em);
      }
    }
  }
</style>

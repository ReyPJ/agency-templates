---
import type { Brand, Hero, Rating } from "../data/types.ts";

interface Props {
  hero: Hero;
  brand: Brand;
  rating?: Rating;
  ctaUrl: string;
}

const { hero, brand, rating, ctaUrl } = Astro.props;
---

{/*
  Editorial hero, no photograph. There is no usable material of the clinic
  itself, and a page with little imagery and a lot of air reads as more
  expensive than one padded with stock.
*/}
<section>
  {rating && (
    <p>
      {/* Decorative: the sentence beside it already carries the meaning. */}
      <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
        <path
          d="M12 1.5l3.09 6.26 6.91 1-5 4.87 1.18 6.87L12 17.27l-6.18 3.25L7 13.63l-5-4.87 6.91-1L12 1.5Z"
        ></path>
      </svg>
      <span>{rating.score}</span>
      <span>de 5 en {rating.count} reseñas de {rating.source}</span>
      {rating.updatedAgo && <span>la más reciente {rating.updatedAgo}</span>}
    </p>
  )}

  {/* One span per line so the staggered reveal can animate them in sequence. */}
  <h1>
    {hero.headline.map((line) => <span>{line}</span>)}
  </h1>

  <p>{hero.subhead}</p>

  <p>
    <a href={ctaUrl} target="_blank" rel="noopener">{hero.cta}</a>
  </p>

  {brand.tagline && <p>{brand.tagline}</p>}
</section>

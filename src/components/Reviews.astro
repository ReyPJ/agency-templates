---
import type { Rating, Reviews } from "../data/types.ts";

interface Props {
  reviews: Reviews;
  rating?: Rating;
}

const { reviews, rating } = Astro.props;
---

{/*
  No carousel. A carousel is JavaScript, and this page spends none — the
  quotes simply stack. Reads as finished with or without verbatim reviews,
  which matters because most clients hand those over late or never.
*/}
<section>
  <h2>{reviews.title}</h2>

  {rating && (
    <p>
      <strong>{rating.score}</strong>
      <span>de 5 en {rating.count} reseñas de {rating.source}</span>
      {rating.updatedAgo && <span>la más reciente {rating.updatedAgo}</span>}
    </p>
  )}

  {/* What patients keep saying, not a claim the clinic makes about itself. */}
  <ul>
    {reviews.themes.map((theme) => <li>{theme}</li>)}
  </ul>

  {reviews.quotes && reviews.quotes.length > 0 && (
    <ul>
      {reviews.quotes.map((quote) => (
        <li>
          <blockquote>
            <p>{quote.text}</p>
          </blockquote>
          <p>
            <cite>{quote.author}</cite>
            {quote.date && <span>{quote.date}</span>}
          </p>
        </li>
      ))}
    </ul>
  )}
</section>

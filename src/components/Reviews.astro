---
import type { Rating, Reviews } from "../data/types.ts";

interface Props {
  reviews: Reviews;
  rating?: Rating;
}

const { reviews, rating } = Astro.props;
---

{/*
  No carousel. A carousel is JavaScript, and this page spends none — the
  quotes simply stack. Reads as finished with or without verbatim reviews,
  which matters because clients hand those over late or never.

  The score runs at graphic scale and in the brand colour because it is the
  strongest evidence on the page and it belongs to the patients, not to the
  clinic's own copy. Set small and grey it read like a caption.
*/}
<section class="shell py-20 md:py-28">
  <h2 class="font-display text-heading">{reviews.title}</h2>

  <div class="mt-12 grid gap-12 md:mt-16 md:grid-cols-12 md:gap-10 lg:gap-16">
    {rating && (
      <div class="md:col-span-4">
        <p class="score font-display tabular-nums text-accent">{rating.score}</p>
        <p class="mt-2 text-small text-ink-soft">
          de 5 en <span class="tabular-nums">{rating.count}</span> reseñas de
          {" "}{rating.source}
        </p>
        {rating.updatedAgo && (
          <p class="text-small text-ink-soft">La más reciente, {rating.updatedAgo}.</p>
        )}
      </div>
    )}

    {/* What patients keep repeating, not a claim the clinic makes about itself. */}
    <div class:list={["md:col-span-7", rating ? "md:col-start-6" : "md:col-start-1"]}>
      <ul class="grid gap-7">
        {reviews.themes.map((theme) => (
          <li class="text-lead">{theme}</li>
        ))}
      </ul>

      {reviews.quotes && reviews.quotes.length > 0 && (
        <ul class="mt-14 grid gap-10">
          {reviews.quotes.map((quote) => (
            <li>
              <blockquote>
                <p class="font-display text-quote italic">{quote.text}</p>
              </blockquote>
              <p class="mt-4 text-small text-ink-soft">
                <cite class="not-italic">{quote.author}</cite>
                {quote.date && <span>, {quote.date}</span>}
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  /* Larger than any other type on the page apart from the headline: the
     number is doing the work of an image here. */
  .score {
    font-size: clamp(5.5rem, 2rem + 13vw, 11rem);
    line-height: 0.8;
    letter-spacing: -0.03em;
  }
</style>

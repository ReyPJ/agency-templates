---
import type { SpecialtiesSection } from "../data/types.ts";

interface Props {
  specialties: SpecialtiesSection;
}

const { specialties } = Astro.props;
---

{/*
  This content is an index — a term and what it means for the patient — so it
  is set as one. Identical cards side by side is the most recognisable tell of
  a template, and a grid also wastes the right third of the page on short lines.

  The rules run edge to edge while the text stays on the page's column. That
  break is deliberate: it is the one place the layout escapes the container,
  and it is what stops every section from sitting inside the same box.

  Deliberately the densest section on the page. Everything around it breathes;
  without one tight block the whole page reads as evenly sparse, which is what
  makes an airy layout look unfinished rather than composed.

  Rows repeat, so four specialties look as considered as nine.
*/}
<section class="bg-surface py-16 md:py-20">
  <div class="shell">
    <h2 class="font-display text-heading">{specialties.title}</h2>
    {specialties.intro && (
      <p class="measure mt-4 text-lead text-ink-soft">{specialties.intro}</p>
    )}
  </div>

  <dl class="mt-10 md:mt-12">
    {specialties.items.map((specialty) => (
      <div class="border-t border-line">
        <div class="shell grid gap-1 py-4 md:grid-cols-12 md:items-baseline md:gap-8 md:py-5">
          <dt class="font-display text-step md:col-span-4">{specialty.name}</dt>
          <dd class="text-ink-soft md:col-span-8">{specialty.solves}</dd>
        </div>
      </div>
    ))}
    <div class="border-t border-line"></div>
  </dl>
</section>

---
import { Image } from "astro:assets";
import type { DoctorsSection } from "../data/types.ts";

interface Props {
  doctors: DoctorsSection;
}

const { doctors } = Astro.props;
---

{/*
  The one section that escapes the container. The portrait runs to the edge of
  the viewport and takes half the screen, so the page stops being a stack of
  equally wide text blocks — and it puts the only real photography on the site
  at a size worth having.

  Sides alternate, which with two doctors reads as composition rather than as a
  pattern, and keeps the eye from settling into a rhythm.

  Quote-led: the quote is the only place the doctors speak, so it runs at
  display scale and the name sits under it as a signature, the way a pull quote
  is attributed in print.

  Any number of doctors works: rows repeat and keep alternating.
*/}
<section class="py-16 md:py-24">
  <div class="shell">
    <h2 class="font-display text-heading">{doctors.title}</h2>
    {doctors.intro && (
      <p class="measure mt-4 text-lead text-ink-soft">{doctors.intro}</p>
    )}
  </div>

  {/* Wider than the page's own column, so the section visibly steps out of it,
      but capped and centred rather than bled to the viewport edge. Bleeding
      looked right at 1440 and fell apart at 1920: the portrait became a
      billboard and the alternating sides opened a dead zone down the middle.
      A break that creates holes is worse than no break. */}
  <ul class="mx-auto mt-12 grid max-w-[1520px] gap-16 px-6 md:mt-16 md:gap-20 md:px-10 lg:px-14">
    {doctors.people.map((doctor, index) => (
      <li class:list={[
        "grid items-center gap-8 md:gap-12 lg:gap-16",
        index % 2 === 1
          ? "md:grid-cols-[minmax(0,1fr)_minmax(0,480px)]"
          : "md:grid-cols-[minmax(0,480px)_minmax(0,1fr)]",
      ]}>
        {doctor.photo && (
          <Image
            src={doctor.photo.src}
            alt={doctor.photo.alt}
            widths={[480, 720, 960]}
            sizes="(min-width: 768px) 480px, 100vw"
            loading="lazy"
            decoding="async"
            class:list={[
              "aspect-4/5 w-full object-cover",
              // Capped in pixels, not in viewport halves: at 1920 a half-screen
              // portrait becomes a billboard, and the source is only 600px wide
              // so it would be upscaled into mush.
              index % 2 === 1 && "md:order-2",
            ]}
          />
        )}

        {/* The text keeps the page's own margin on the outer side, so it stays
            on the same column as every other section while the photo does not. */}
        <div>
          <blockquote>
            <p class="font-display text-step italic">{doctor.quote}</p>
          </blockquote>

          <div class="mt-7 flex flex-wrap items-baseline gap-x-3 gap-y-1">
            <h3 class="font-medium">{doctor.name}</h3>
            <p class="text-small text-accent">{doctor.role}</p>
          </div>

          <p class="measure mt-5 text-small text-ink-soft">{doctor.duties}</p>

          {doctor.personalNote && (
            <p class="measure mt-2 text-small text-ink-soft">{doctor.personalNote}</p>
          )}

          {doctor.license && (
            <p class="mt-2 text-small text-ink-soft">
              Cédula profesional <span class="tabular-nums">{doctor.license}</span>
            </p>
          )}
        </div>
      </li>
    ))}
  </ul>
</section>

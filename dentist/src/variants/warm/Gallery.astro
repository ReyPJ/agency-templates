---
import { Image } from "astro:assets";
import type { Gallery } from "../../data/types.ts";

interface Props {
  gallery: Gallery;
}

const { gallery } = Astro.props;
---

{/*
  Three pictures at a time in a staggered row — the middle one dropped, the
  first one arched — so the strip has the rhythm of photos pinned to a wall
  rather than a grid. On a phone the row becomes a swipeable strip.
*/}
<section class="py-20 md:py-28">
  <div class="shell mx-auto max-w-[44rem] text-center">
    <h2 class="font-display text-heading text-balance">{gallery.title}</h2>
    {gallery.intro && <p class="mt-5 text-lead text-ink-soft">{gallery.intro}</p>}
  </div>

  <ul class:list={["warm-gallery shell mt-12 md:mt-16", gallery.photos.length % 4 === 0 && "is-four"]}>
    {gallery.photos.map((photo, index) => (
      <li>
        <figure>
          <div class:list={["reveal-photo aspect-3/4 overflow-hidden", index === 0 ? "arch" : "rounded-[28px]"]}>
            <Image
              src={photo.src}
              alt={photo.alt}
              widths={[400, 640, 900]}
              sizes="(min-width: 768px) 30vw, 78vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover"
            />
          </div>
          {photo.caption && <figcaption class="mt-3 text-small text-ink-soft">{photo.caption}</figcaption>}
        </figure>
      </li>
    ))}
  </ul>
</section>

<style>
  .arch {
    border-radius: 999px 999px 28px 28px;
  }
  .warm-gallery {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: 78%;
    gap: 16px;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
    scroll-padding-inline: 24px;
  }
  .warm-gallery::-webkit-scrollbar {
    display: none;
  }
  .warm-gallery > li {
    scroll-snap-align: start;
  }
  @media (min-width: 768px) {
    .warm-gallery {
      grid-auto-flow: row;
      grid-template-columns: repeat(3, minmax(0, 1fr));
      gap: 32px;
      overflow: visible;
    }
    .warm-gallery:not(.is-four) > li:nth-child(3n + 2) {
      margin-top: 72px;
    }
    /* Four (or eight) pictures run four abreast, dropping every other one,
       so no row is left with a single orphan. */
    .warm-gallery.is-four {
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 24px;
    }
    .warm-gallery.is-four > li:nth-child(even) {
      margin-top: 56px;
    }
  }
</style>

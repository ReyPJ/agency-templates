---
import { Image } from "astro:assets";
import type { Brand, Closing, Contact, Location } from "../../data/types.ts";
import WhatsAppIcon from "../../components/icons/WhatsAppIcon.astro";

interface Props {
  location?: Location;
  contact: Contact;
  brand: Brand;
  closing: Closing;
  ctaUrl: string;
}

const { location, contact, brand, closing, ctaUrl } = Astro.props;
const year = new Date().getFullYear();
---

{/*
  The close is a rounded block in the brand colour, centred and short: an
  invitation, then the two ways to take it. The practical details follow on
  the page's own ground. No embedded map — a link to the listing does the job
  without third-party cookies or hundreds of kilobytes.
*/}
<section class="shell pb-6">
  <div class="rounded-[40px] bg-accent px-8 py-16 text-center text-accent-ink md:px-14 md:py-24">
    <h2 class="mx-auto max-w-[18ch] font-display text-display text-balance">{closing.headline}</h2>
    <div class="mt-10 flex flex-col items-center justify-center gap-4 sm:flex-row">
      <a
        href={ctaUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-12 w-full items-center justify-center gap-2 whitespace-nowrap rounded-full bg-accent-ink px-8 py-4 font-semibold text-accent transition-opacity hover:opacity-90 sm:w-auto"
      >
        <WhatsAppIcon class="size-[18px]" />
        <span>{closing.cta}</span>
      </a>
      <a
        href={`tel:${contact.phone}`}
        class="inline-flex min-h-12 items-center justify-center whitespace-nowrap rounded-full border border-current px-8 tabular-nums transition-opacity hover:opacity-80"
      >
        Llamar al {contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<footer class="shell py-14 pb-32 md:py-16 md:pb-16">
  <div class="grid gap-10 sm:grid-cols-2 lg:grid-cols-4">
    <div class="flex items-start gap-4">
      {brand.logo && (
        <Image
          src={brand.logo.src}
          alt=""
          widths={[48, 96]}
          sizes="48px"
          loading="lazy"
          decoding="async"
          class="size-12 shrink-0 rounded-full object-cover"
        />
      )}
      <div>
        <p class="font-display text-lead">{brand.name}</p>
        {brand.tagline && <p class="mt-1 text-small text-ink-soft">{brand.tagline}</p>}
      </div>
    </div>

    {location && (
      <div>
        <h3 class="font-semibold">{location.title}</h3>
        <address class="mt-3 grid gap-1 not-italic text-ink-soft">
          {location.address?.map((line) => <span>{line}</span>)}
          <span>{location.area}</span>
        </address>
        {location.mapUrl && (
          <a href={location.mapUrl} target="_blank" rel="noopener" class="mt-3 inline-flex min-h-11 items-center font-semibold text-accent underline underline-offset-4 hover:no-underline">
            Cómo llegar
          </a>
        )}
      </div>
    )}

    {location?.hours && location.hours.length > 0 && (
      <div>
        <h3 class="font-semibold">Horario</h3>
        <dl class="mt-3 grid gap-1 text-ink-soft">
          {location.hours.map((slot) => (
            <div class="flex justify-between gap-6">
              <dt>{slot.days}</dt>
              <dd class="tabular-nums">{slot.time}</dd>
            </div>
          ))}
        </dl>
      </div>
    )}

    <div>
      <h3 class="font-semibold">Contacto</h3>
      <ul class="mt-3 grid gap-1 text-ink-soft">
        <li><a href={`tel:${contact.phone}`} class="tabular-nums hover:text-ink">{contact.phoneDisplay}</a></li>
        <li><a href={ctaUrl} target="_blank" rel="noopener" class="hover:text-ink">WhatsApp</a></li>
        {contact.social?.instagram && (
          <li><a href={contact.social.instagram} target="_blank" rel="noopener" class="hover:text-ink">Instagram</a></li>
        )}
        {contact.social?.facebook && (
          <li><a href={contact.social.facebook} target="_blank" rel="noopener" class="hover:text-ink">Facebook</a></li>
        )}
      </ul>
      {(location?.paymentMethods?.length || location?.installments) && (
        <p class="mt-4 text-small text-ink-soft">
          {location.paymentMethods?.join(", ")}
          {location.installments && <>{location.paymentMethods?.length ? ". " : ""}Meses sin intereses.</>}
        </p>
      )}
    </div>
  </div>

  <div class="mt-12 flex flex-col gap-2 border-t border-line pt-8 text-small text-ink-soft sm:flex-row sm:justify-between">
    <p class="tabular-nums">© {year} {brand.name}</p>
    {brand.registration && (
      <p>{brand.registration.label} <span class="tabular-nums">{brand.registration.value}</span></p>
    )}
  </div>
</footer>

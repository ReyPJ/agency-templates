---
import type { Highlight } from "../../data/types.ts";

interface Props {
  highlights: Highlight[];
}

const { highlights } = Astro.props;
---

<section class="shell">
  <dl class="grid gap-8 rounded-[32px] bg-surface px-8 py-10 sm:grid-cols-3 md:px-12 md:py-12">
    {highlights.map((item) => (
      <div>
        <dt class="font-display text-heading tabular-nums text-accent">{item.value}</dt>
        <dd class="mt-2 max-w-[24ch] text-ink-soft">{item.label}</dd>
      </div>
    ))}
  </dl>
</section>

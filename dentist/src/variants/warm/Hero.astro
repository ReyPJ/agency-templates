---
import { Image } from "astro:assets";
import type { Hero, Rating } from "../../data/types.ts";

interface Props {
  hero: Hero;
  rating?: Rating;
  ctaUrl: string;
}

const { hero, rating, ctaUrl } = Astro.props;
---

{/*
  The arch is the variant's one shape: a doorway, the outline of somewhere you
  are welcome. It frames the hero photograph and comes back on the portraits,
  so the page has a motif rather than a stack of rectangles.

  The rating rides on the arch as a round seal — the patients' verdict pinned
  to the picture of the place, not a line of grey text under the button.

  On load the arch rises out of its own baseline; that is the page's single
  orchestrated moment.
*/}
<section class="shell grid items-end gap-12 pt-28 pb-16 md:pt-36 md:pb-24 lg:grid-cols-12 lg:gap-8">
  <div class:list={["lg:pb-10", hero.image ? "lg:col-span-7" : "lg:col-span-10"]}>
    <h1 class="font-display text-display text-balance">
      {hero.headline.map((line) => <span class="hero-line">{line} </span>)}
    </h1>

    <p class="measure mt-7 text-lead text-ink-soft">{hero.subhead}</p>

    <a
      href={ctaUrl}
      target="_blank"
      rel="noopener"
      class="mt-10 inline-flex min-h-12 w-full items-center justify-center whitespace-nowrap rounded-full bg-accent px-8 py-4 font-semibold text-accent-ink transition-opacity hover:opacity-90 sm:w-auto"
    >
      {hero.cta}
    </a>
  </div>

  {hero.image && (
    <div class="relative mx-auto w-full max-w-[460px] lg:col-span-5 lg:max-w-none">
      <div class="arch hero-arch aspect-4/5 overflow-hidden">
        <Image
          src={hero.image.src}
          alt={hero.image.alt}
          widths={[480, 720, 960, 1280]}
          sizes="(min-width: 1024px) 40vw, 460px"
          loading="eager"
          fetchpriority="high"
          class="size-full object-cover"
        />
      </div>

      {rating && (
        <p class="seal absolute -left-2 bottom-10 grid size-32 place-content-center rounded-full bg-accent-light text-center text-ink md:-left-10 md:size-36">
          <span class="font-display text-heading tabular-nums">{rating.score}</span>
          <span class="mt-1 px-3 text-[0.8125rem] leading-tight">
            en <span class="tabular-nums">{rating.count}</span> reseñas de {rating.source}
          </span>
        </p>
      )}
    </div>
  )}
</section>

<style>
  .arch {
    border-radius: 999px 999px 28px 28px;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-arch {
      animation: arch-rise 1.1s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }
    .seal {
      animation: seal-in 0.6s cubic-bezier(0.3, 1.4, 0.5, 1) 0.8s backwards;
    }
    .hero-line {
      animation: line-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }
    .hero-line:nth-child(2) { animation-delay: 0.1s; }
    .hero-line:nth-child(3) { animation-delay: 0.2s; }
    .hero-line:nth-child(4) { animation-delay: 0.3s; }

    @keyframes arch-rise {
      from { clip-path: inset(100% 0 0 0 round 999px 999px 28px 28px); }
      to { clip-path: inset(0 0 0 0 round 999px 999px 28px 28px); }
    }
    @keyframes seal-in {
      from { opacity: 0; transform: scale(0.6) rotate(-12deg); }
    }
    @keyframes line-in {
      from { opacity: 0; }
    }
  }
</style>

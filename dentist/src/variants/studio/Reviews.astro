---
import type { Rating, Reviews } from "../../data/types.ts";

interface Props {
  reviews: Reviews;
  rating?: Rating;
}

const { reviews, rating } = Astro.props;
---

{/*
  The score sits beside the title as a figure, light and very large; what
  patients repeat runs down the right as plain statements. No stars row, no
  carousel: one number and the words behind it.
*/}
<section class="py-20 md:py-28">
  <div class="shell grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5">
      <h2 class="font-display text-heading">{reviews.title}</h2>
      {rating && (
        <div class="mt-10">
          <p class="score font-light tabular-nums">{rating.score}</p>
          <p class="mt-3 text-small text-ink-soft">
            de 5 en <span class="tabular-nums">{rating.count}</span> reseñas de {rating.source}
            {rating.updatedAgo && <>, la más reciente {rating.updatedAgo}</>}
          </p>
          {rating.profileUrl && (
            <a
              href={rating.profileUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex min-h-11 items-center text-small text-accent underline underline-offset-4 hover:no-underline"
            >
              Leer las reseñas
            </a>
          )}
        </div>
      )}
    </div>

    <div class="md:col-span-7">
      <ul>
        {reviews.themes.map((theme) => (
          <li class="border-t border-line py-6 text-step first:border-t-0 first:pt-0">{theme}</li>
        ))}
      </ul>

      {reviews.quotes && reviews.quotes.length > 0 && (
        <ul class="mt-10 grid gap-8">
          {reviews.quotes.map((quote) => (
            <li class="border-l border-accent pl-6">
              <blockquote>
                <p class="text-lead">“{quote.text}”</p>
              </blockquote>
              <p class="mt-3 text-small text-ink-soft">
                <cite class="not-italic">{quote.author}</cite>
                {quote.date && <span>, {quote.date}</span>}
              </p>
            </li>
          ))}
        </ul>
      )}
    </div>
  </div>
</section>

<style>
  .score {
    font-size: clamp(5rem, 2rem + 10vw, 9rem);
    line-height: 0.8;
    letter-spacing: -0.04em;
  }
</style>

---
import { Image } from "astro:assets";
import type { Brand, Closing, Contact, Location, Photo } from "../../data/types.ts";
import WhatsAppIcon from "../../components/icons/WhatsAppIcon.astro";

interface Props {
  location?: Location;
  contact: Contact;
  brand: Brand;
  closing: Closing;
  ctaUrl: string;
  /** Used when closing.image is missing, so the close keeps a picture. */
  fallbackImage?: Photo;
}

const { location, contact, brand, closing, ctaUrl, fallbackImage } = Astro.props;
const image = closing.image ?? fallbackImage;
const year = new Date().getFullYear();
---

{/*
  The close is the space again, full bleed, with the invitation laid over it.
  A tinted layer of the dark brand colour keeps the type legible over any
  photograph without guessing at where the picture's light falls.

  Then the footer, on the same dark ground, holds everything practical. No
  embedded map: a Google Maps iframe sets third-party cookies and costs
  hundreds of kilobytes to show worse what a link to the listing shows better.
*/}
<section class="relative isolate overflow-hidden bg-inverted-background text-inverted-ink">
  {image && (
    <>
      <Image
        src={image.src}
        alt=""
        widths={[640, 960, 1280, 1600, 2000]}
        sizes="100vw"
        loading="lazy"
        decoding="async"
        class="closing-img absolute inset-0 -z-10 size-full object-cover"
      />
      <div class="absolute inset-0 -z-10 bg-inverted-background/75"></div>
    </>
  )}

  <div class="shell flex min-h-[70svh] flex-col justify-end gap-10 py-20 md:flex-row md:items-end md:justify-between md:py-28">
    <h2 class="max-w-[16ch] font-display text-display font-light text-balance">
      {closing.headline}
    </h2>

    <div class="flex shrink-0 flex-col items-start gap-4 md:items-end">
      <a
        href={ctaUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-12 w-full items-center justify-center gap-2 whitespace-nowrap rounded-full bg-inverted-ink px-8 py-4 font-medium text-inverted-background transition-opacity hover:opacity-90 sm:w-auto"
      >
        <WhatsAppIcon class="size-[18px]" />
        <span>{closing.cta}</span>
      </a>
      <a href={`tel:${contact.phone}`} class="tabular-nums text-inverted-ink-soft transition-colors hover:text-inverted-ink">
        {contact.phoneDisplay}
      </a>
    </div>
  </div>
</section>

<footer class="bg-inverted-background text-inverted-ink-soft">
  <div class="shell border-t border-inverted-ink-soft/25 py-14 pb-32 md:py-16 md:pb-16">
    <div class="grid gap-10 sm:grid-cols-2 md:grid-cols-12 md:gap-8">
      <div class="md:col-span-4">
        <p class="text-lead font-medium text-inverted-ink">{brand.name}</p>
        {brand.tagline && <p class="mt-2 max-w-[30ch]">{brand.tagline}</p>}
      </div>

      {location && (
        <div class="md:col-span-3">
          <h3 class="text-inverted-ink">{location.title}</h3>
          <address class="mt-3 grid gap-1 not-italic">
            {location.address?.map((line) => <span>{line}</span>)}
            <span>{location.area}</span>
          </address>
          {location.mapUrl && (
            <a
              href={location.mapUrl}
              target="_blank"
              rel="noopener"
              class="mt-3 inline-flex min-h-11 items-center text-accent-light underline underline-offset-4 hover:no-underline"
            >
              Cómo llegar
            </a>
          )}
        </div>
      )}

      {location?.hours && location.hours.length > 0 && (
        <dl class="grid content-start gap-2 md:col-span-3">
          {location.hours.map((slot) => (
            <div class="flex justify-between gap-6">
              <dt>{slot.days}</dt>
              <dd class="tabular-nums text-inverted-ink">{slot.time}</dd>
            </div>
          ))}
        </dl>
      )}

      <ul class="grid content-start gap-2 md:col-span-2">
        <li>
          <a href={`tel:${contact.phone}`} class="tabular-nums hover:text-inverted-ink">{contact.phoneDisplay}</a>
        </li>
        <li>
          <a href={ctaUrl} target="_blank" rel="noopener" class="hover:text-inverted-ink">WhatsApp</a>
        </li>
        {contact.social?.instagram && (
          <li>
            <a href={contact.social.instagram} target="_blank" rel="noopener" class="hover:text-inverted-ink">Instagram</a>
          </li>
        )}
        {contact.social?.facebook && (
          <li>
            <a href={contact.social.facebook} target="_blank" rel="noopener" class="hover:text-inverted-ink">Facebook</a>
          </li>
        )}
      </ul>
    </div>

    {(location?.paymentMethods?.length || location?.installments) && (
      <p class="mt-10 text-small">
        {location.paymentMethods?.join(", ")}
        {location.installments && <>{location.paymentMethods?.length ? ". " : ""}Aceptamos meses sin intereses.</>}
      </p>
    )}

    <div class="mt-12 flex flex-col gap-2 border-t border-inverted-ink-soft/25 pt-8 text-small sm:flex-row sm:justify-between">
      <p class="tabular-nums">© {year} {brand.name}</p>
      {brand.registration && (
        <p>
          {brand.registration.label} <span class="tabular-nums">{brand.registration.value}</span>
        </p>
      )}
    </div>
  </div>
</footer>

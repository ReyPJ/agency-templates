---
import { Image } from "astro:assets";
import type { Hero, Rating, Services } from "../../data/types.ts";

interface Props {
  hero: Hero;
  rating?: Rating;
  ctaUrl: string;
  services?: Services;
}

const { hero, rating, ctaUrl, services } = Astro.props;
const firstVisit = services?.items.find((item) => item.price);
// The display size is set for short, punchy lines ("Diseñamos"). A longer
// line at that size breaks in two inside the copy column, so the headline
// steps down when its longest line passes a dozen characters.
const longHeadline = Math.max(...hero.headline.map((line) => line.length)) > 11;
---

{/*
  Split screen: the words on the page's own ground, the clinic's space on the
  right, bled to the edge and to the full height of the screen. The picture is
  the claim — a visitor sees where they would sit before reading a line.

  Without a photograph the text simply takes the whole width, so a client with
  no images still gets a finished hero instead of a hole.

  The load sequence is the page's one orchestrated moment: the photo opens
  upward like a blind while the headline rises line by line.
*/}
<section
  class:list={[
    "studio-hero grid lg:min-h-svh",
    hero.image && "lg:grid-cols-[minmax(0,7fr)_minmax(0,5fr)]",
  ]}
>
  <div class="hero-copy flex flex-col justify-end pt-32 pb-12 md:pt-40 md:pb-16">
    <h1 class:list={["font-display text-display font-light", longHeadline && "hero-long"]}>
      {hero.headline.map((line) => <span class="hero-line block">{line}</span>)}
    </h1>

    <p class="measure mt-8 text-lead text-ink-soft md:mt-10">{hero.subhead}</p>

    <div class="mt-10 flex flex-col items-start gap-6 sm:flex-row sm:items-center md:mt-12">
      <a
        href={ctaUrl}
        target="_blank"
        rel="noopener"
        class="inline-flex min-h-12 w-full items-center justify-center whitespace-nowrap rounded-full bg-accent px-8 py-4 font-medium text-accent-ink transition-opacity hover:opacity-90 sm:w-auto"
      >
        {hero.cta}
      </a>

      {rating && (
        <p class="text-small text-ink-soft">
          <strong class="font-medium tabular-nums text-ink">{rating.score}</strong> de 5
          en <span class="tabular-nums">{rating.count}</span> reseñas de {rating.source}
        </p>
      )}
    </div>
  </div>

  {hero.image && (
    <figure class="hero-figure relative h-[62svh] overflow-hidden md:h-[70svh] lg:h-auto">
      <div class="hero-parallax absolute inset-x-0 -top-[6%] h-[112%]">
        <Image
          src={hero.image.src}
          alt={hero.image.alt}
              style={hero.image.focus ? `object-position: ${hero.image.focus}` : undefined}
          widths={[640, 960, 1280, 1600]}
          sizes="(min-width: 1024px) 42vw, 100vw"
          loading="eager"
          fetchpriority="high"
          class="hero-img absolute inset-0 size-full object-cover"
        />
      </div>
      {hero.image.caption && (
        <figcaption class="absolute top-24 right-0 bg-background px-4 py-3 text-small text-ink-soft md:top-28">
          {hero.image.caption}
        </figcaption>
      )}

      {/* The first published price, pinned to the picture — list the entry
          visit first in services.items so this is the one that shows. Proof that this
          clinic says what things cost sits where the eye already is. */}
      {firstVisit?.price && (
        <a
          href="#precios"
          class="price-card absolute bottom-6 left-6 flex items-center gap-5 bg-background px-6 py-5 text-ink transition-colors hover:bg-surface md:bottom-10 md:left-10"
        >
          <span class="max-w-[12ch] text-small leading-tight text-ink-soft">{firstVisit.name}</span>
          <span class="text-heading font-light tabular-nums">{firstVisit.price}</span>
        </a>
      )}
    </figure>
  )}
</section>

<style>
  /* The copy column keeps the page's outer margin on its left edge, so the
     headline lines up with every section below while the photo runs off the
     right of the screen. */
  .hero-copy {
    padding-inline: 24px;
  }
  .hero-long {
    font-size: clamp(2.75rem, 0.9rem + 5.6vw, 6.75rem);
  }
  @media (min-width: 768px) {
    .hero-copy {
      padding-inline: 48px;
    }
  }
  @media (min-width: 1280px) {
    .hero-copy {
      padding-inline-start: max(64px, calc(50vw - 680px + 64px));
      padding-inline-end: 64px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero-line {
      animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }
    .hero-line:nth-child(1) { animation-delay: 0.25s; }
    .hero-line:nth-child(2) { animation-delay: 0.35s; }
    .hero-line:nth-child(3) { animation-delay: 0.45s; }
    .hero-line:nth-child(4) { animation-delay: 0.55s; }

    .hero-figure {
      animation: open 1.2s cubic-bezier(0.7, 0, 0.2, 1) backwards;
    }
    /* The image settles while the blind opens, so the reveal reads as a
       camera coming to rest rather than a rectangle being wiped in. */
    .hero-img {
      animation: settle 2.2s cubic-bezier(0.2, 0.7, 0.2, 1) backwards;
    }

    .price-card {
      animation: card-in 0.8s cubic-bezier(0.2, 0.7, 0.2, 1) 1.05s backwards;
    }
    @keyframes card-in {
      from { opacity: 0; transform: translateY(16px); }
    }

    /* After the load the picture drifts slower than the page, a small depth
       cue tied to scroll. It runs on the figure, not the image, so it never
       fights the settle animation. */
    @supports (animation-timeline: scroll()) {
      .hero-parallax {
        animation: drift linear both;
        animation-timeline: scroll(root);
        animation-range: 0 100vh;
      }
      @keyframes drift {
        to { transform: translateY(5%); }
      }
    }

    @keyframes rise {
      from { opacity: 0; transform: translateY(0.4em); }
    }
    @keyframes open {
      from { clip-path: inset(100% 0 0 0); }
      to { clip-path: inset(0 0 0 0); }
    }
    @keyframes settle {
      from { transform: scale(1.14); }
    }
  }
</style>

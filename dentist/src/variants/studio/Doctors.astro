---
import { Image } from "astro:assets";
import type { DoctorsSection } from "../../data/types.ts";

interface Props {
  doctors: DoctorsSection;
}

const { doctors } = Astro.props;

// A team photo with one or two named doctors reads best as a pair: picture on
// the left, the people on the right. With a longer roster the photo runs full
// width and the list follows below it.
const sideBySide = Boolean(doctors.groupPhoto) && doctors.people.length <= 2;
---

{/*
  Team first, then names. A group photograph says "these are the people who
  will be in the room" faster than any line of copy, so when there is one it
  runs at full column width before the roster.

  The roster is a list with rules, not a row of cards: one line per person,
  name on the left, what they do on the right. It holds one doctor as well as
  six, and works whether or not each person has a portrait.
*/}
<section class="py-20 md:py-28">
  <div class="shell">
    <div class="grid gap-6 md:grid-cols-12 md:items-end md:gap-8">
      <h2 class="font-display text-heading md:col-span-6">{doctors.title}</h2>
      {doctors.intro && (
        <p class="measure text-lead text-ink-soft md:col-span-5 md:col-start-8">{doctors.intro}</p>
      )}
    </div>

    {sideBySide ? (
      <>
    <div class="mt-12 grid gap-10 md:mt-16 md:grid-cols-12 md:gap-8">
      {doctors.groupPhoto && (
        <figure class="md:col-span-5">
          <div class="reveal-photo aspect-4/3 overflow-hidden">
            <Image
              src={doctors.groupPhoto.src}
              alt={doctors.groupPhoto.alt}
              style={doctors.groupPhoto.focus ? `object-position: ${doctors.groupPhoto.focus}` : undefined}
              widths={[480, 720, 1000, 1400]}
              sizes="(min-width: 1360px) 500px, (min-width: 768px) 40vw, 100vw"
              loading="lazy"
              decoding="async"
              class="size-full object-cover"
            />
          </div>
          {doctors.groupPhoto.caption && (
            <figcaption class="mt-3 text-small text-ink-soft">{doctors.groupPhoto.caption}</figcaption>
          )}
        </figure>
      )}

      <ul class:list={["self-start", doctors.groupPhoto ? "md:col-span-6 md:col-start-7" : "md:col-span-12"]}>
        {doctors.people.map((doctor) => (
          <li class="border-t border-line py-8 first:border-t-0 first:pt-0">
            <h3 class="text-heading font-light">{doctor.name}</h3>
            <p class="mt-3 text-accent">{doctor.role}</p>
            {doctor.license && (
              <p class="mt-1 text-small text-ink-soft">
                Cédula profesional <span class="tabular-nums">{doctor.license}</span>
              </p>
            )}
            {doctor.quote && (
              <blockquote class="mt-6">
                <p class="text-lead">“{doctor.quote}”</p>
              </blockquote>
            )}
            <p class="measure mt-5 text-ink-soft">{doctor.duties}</p>
            {doctor.personalNote && (
              <p class="measure mt-3 text-small text-ink-soft">{doctor.personalNote}</p>
            )}
          </li>
        ))}
      </ul>
    </div>
      </>
    ) : (
      <>
    {doctors.groupPhoto && (
      <figure class="mt-12 md:mt-16">
        <div class="reveal-photo aspect-4/3 overflow-hidden md:aspect-16/9">
          <Image
            src={doctors.groupPhoto.src}
            alt={doctors.groupPhoto.alt}
            style={doctors.groupPhoto.focus ? `object-position: ${doctors.groupPhoto.focus}` : undefined}
            widths={[640, 960, 1280, 1600, 2000]}
            sizes="(min-width: 1360px) 1232px, 100vw"
            loading="lazy"
            decoding="async"
            class="size-full object-cover"
          />
        </div>
        {doctors.groupPhoto.caption && (
          <figcaption class="mt-3 text-small text-ink-soft">{doctors.groupPhoto.caption}</figcaption>
        )}
      </figure>
    )}

    <ul class="mt-12 md:mt-16">
      {doctors.people.map((doctor) => (
        <li class="grid gap-6 border-t border-line py-8 md:grid-cols-12 md:gap-8 md:py-10">
          <div class="flex items-start gap-5 md:col-span-5">
            {doctor.photo && (
              <Image
                src={doctor.photo.src}
                alt={doctor.photo.alt}
                widths={[160, 320]}
                sizes="112px"
                loading="lazy"
                decoding="async"
                class="aspect-4/5 w-24 shrink-0 object-cover md:w-28"
              />
            )}
            <div>
              <h3 class="text-step">{doctor.name}</h3>
              <p class="mt-2 text-small text-accent">{doctor.role}</p>
              {doctor.license && (
                <p class="mt-1 text-small text-ink-soft">
                  Cédula profesional <span class="tabular-nums">{doctor.license}</span>
                </p>
              )}
            </div>
          </div>

          <div class="md:col-span-7">
            {doctor.quote && (
              <blockquote class="mb-5">
                <p class="text-lead">“{doctor.quote}”</p>
              </blockquote>
            )}
            <p class:list={["measure", doctor.quote ? "text-ink-soft" : "text-lead"]}>{doctor.duties}</p>
            {doctor.personalNote && (
              <p class="measure mt-3 text-small text-ink-soft">{doctor.personalNote}</p>
            )}
          </div>
        </li>
      ))}
    </ul>
      </>
    )}
  </div>
</section>

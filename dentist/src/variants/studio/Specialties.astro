---
import { Image } from "astro:assets";
import type { SpecialtiesSection } from "../../data/types.ts";

interface Props {
  specialties: SpecialtiesSection;
}

const { specialties } = Astro.props;
const hasImages = specialties.items.some((item) => item.image);
---

{/*
  An accordion built on <details name>: exclusive, keyboard-accessible and
  searchable with the browser's find, with no script. Names alone make a calm,
  scannable column; the explanation is one tap away for whoever needs it.

  The heading column sticks while the list scrolls past it, so on a long list
  the section never loses its title.

  The first entry starts open so the pattern explains itself.
*/}
<section class="specialties border-t border-line py-20 md:py-28">
  <div class="shell grid gap-12 md:grid-cols-12 md:gap-8">
    <div class="md:col-span-5">
      <div class="md:sticky md:top-28">
        <h2 class="font-display text-heading">{specialties.title}</h2>
        {specialties.intro && (
          <p class="measure mt-5 text-lead text-ink-soft">{specialties.intro}</p>
        )}
        {/* Every picture is stacked in the same frame; the open entry in the
            list decides which one is visible, through :has(). No script, and
            with nothing open the first one stays. Entries without an image
            leave the last one shown. */}
        {hasImages && (
          <div class="specialty-frame relative mt-10 hidden aspect-4/5 max-w-[380px] overflow-hidden bg-surface md:block">
            {specialties.items.map((item, index) =>
              item.image && (
                <Image
                  src={item.image.src}
                  alt=""
                  widths={[380, 760]}
                  sizes="380px"
                  loading="eager"
                  decoding="async"
                  data-index={index}
                  class="specialty-img absolute inset-0 size-full object-cover"
                />
              ),
            )}
          </div>
        )}
      </div>
    </div>

    <div class="md:col-span-7">
      {specialties.items.map((specialty, index) => (
        <details name="specialties" open={index === 0} class="specialty border-b border-line">
          <summary class="flex min-h-11 cursor-pointer list-none items-center justify-between gap-6 py-5 md:py-6">
            <span class="text-step">{specialty.name}</span>
            <span class="toggle relative size-4 shrink-0" aria-hidden="true"></span>
          </summary>
          <p class="measure pb-6 text-ink-soft">{specialty.solves}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<style>
  .specialty-img {
    opacity: 0;
    transform: scale(1.06);
    transition: opacity 0.6s ease, transform 1.2s cubic-bezier(0.2, 0.7, 0.2, 1);
  }
  .specialties:not(:has(details[open])) .specialty-img[data-index="0"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(1)[open]) .specialty-img[data-index="0"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(2)[open]) .specialty-img[data-index="1"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(3)[open]) .specialty-img[data-index="2"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(4)[open]) .specialty-img[data-index="3"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(5)[open]) .specialty-img[data-index="4"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(6)[open]) .specialty-img[data-index="5"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(7)[open]) .specialty-img[data-index="6"] {
    opacity: 1;
    transform: scale(1);
  }
  .specialties:has(details:nth-of-type(8)[open]) .specialty-img[data-index="7"] {
    opacity: 1;
    transform: scale(1);
  }
  @media (prefers-reduced-motion: reduce) {
    .specialty-img {
      transition: none;
    }
  }

  .specialty summary::-webkit-details-marker {
    display: none;
  }
  .specialty summary:hover .toggle::before,
  .specialty summary:hover .toggle::after {
    background-color: var(--color-accent);
  }

  /* A plus that turns into a minus: the vertical bar folds down into the
     horizontal one, which shows the action being reversible. */
  .toggle::before,
  .toggle::after {
    content: "";
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background-color: var(--color-ink);
    transition: transform 0.3s cubic-bezier(0.2, 0.7, 0.2, 1), background-color 0.2s;
  }
  .toggle::after {
    transform: rotate(90deg);
  }
  .specialty[open] .toggle::after {
    transform: rotate(0deg);
  }

  /* Where the browser can animate to height: auto, the answer slides open.
     Elsewhere it simply appears, which is the correct result anyway. */
  @media (prefers-reduced-motion: no-preference) {
    .specialty {
      interpolate-size: allow-keywords;
    }
    .specialty::details-content {
      block-size: 0;
      overflow: hidden;
      transition: block-size 0.4s cubic-bezier(0.2, 0.7, 0.2, 1), content-visibility 0.4s allow-discrete;
    }
    .specialty[open]::details-content {
      block-size: auto;
    }
  }
</style>

---
import type { Clinic, Variant } from "../data/types.ts";
import "../styles/global.css";

interface Props {
  clinic: Clinic;
  variant: Variant;
}

const { clinic, variant } = Astro.props;

// Only the faces a variant uses above the fold. Preloading a face the page
// never paints wastes the bandwidth the LCP needs.
const preloads: Record<Variant, string[]> = {
  editorial: ["/fonts/instrument-serif.woff2", "/fonts/inter.woff2"],
  studio: ["/fonts/jost.woff2"],
  warm: ["/fonts/young-serif.woff2", "/fonts/figtree.woff2"],
};
const { brand, seo, theme, contact, rating, location } = clinic;

const canonical = new URL(Astro.url.pathname, seo.url).href;

// Built from the client data, so a new client gets correct structured data
// without anyone editing this file.
const structuredData: Record<string, unknown> = {
  "@context": "https://schema.org",
  "@type": "Dentist",
  name: brand.name,
  description: seo.description,
  url: seo.url,
  telephone: contact.phone,
};

const sameAs = Object.values(contact.social ?? {}).filter(Boolean);
if (sameAs.length) {
  structuredData.sameAs = sameAs;
}

if (brand.logo) {
  structuredData.image = new URL(brand.logo.src.src, seo.url).href;
}

if (rating) {
  structuredData.aggregateRating = {
    "@type": "AggregateRating",
    ratingValue: rating.score,
    reviewCount: rating.count,
  };
}

if (location?.address?.length) {
  structuredData.address = {
    "@type": "PostalAddress",
    streetAddress: location.address.join(", "),
    addressLocality: location.area,
    addressCountry: "MX",
  };
} else if (location?.area) {
  // No street address yet — say what area is served rather than emit an
  // address that is only half true.
  structuredData.areaServed = location.area;
}

if (location?.hours?.length) {
  structuredData.openingHours = location.hours.map((h) => `${h.days} ${h.time}`);
}
---

<!doctype html>
<html lang="es" data-variant={variant}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    {/* Set before first paint so revealed elements never flash in and out. */}
    <script is:inline>document.documentElement.classList.add("js");</script>

    <title>{seo.title}</title>
    <meta name="description" content={seo.description} />
    <link rel="canonical" href={canonical} />

    {/* Every face a variant uses above the fold is preloaded: the headline is
        the display face, the subhead and button the body face, and Lighthouse
        measures the LCP on the subhead. Discovering either one late cost 1.3s
        of render delay on the editorial variant. */}
    {preloads[variant].map((href) => (
      <link rel="preload" href={href} as="font" type="font/woff2" crossorigin />
    ))}

    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/favicon-180.png" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_MX" />
    <meta property="og:site_name" content={brand.name} />
    <meta property="og:title" content={seo.title} />
    <meta property="og:description" content={seo.description} />
    <meta property="og:url" content={canonical} />
    {brand.logo && (
      <meta property="og:image" content={new URL(brand.logo.src.src, seo.url).href} />
    )}

    {/* Data, not executable code: is:inline keeps Astro from bundling it,
        so it costs nothing against the JavaScript budget. */}
    <script
      type="application/ld+json"
      is:inline
      set:html={JSON.stringify(structuredData)}
    />
  </head>

  <body>
    <slot />

    {/* Marks each photograph visible the first time it enters the viewport,
        then stops watching it. Pictures in the same row get a small stagger.
        A dozen lines, inline, and the page reads correctly without them. */}
    <script is:inline>
      (() => {
        const items = document.querySelectorAll(".reveal-photo");
        if (!("IntersectionObserver" in window)) {
          items.forEach((el) => el.classList.add("is-visible"));
          return;
        }
        const io = new IntersectionObserver((entries) => {
          entries
            .filter((e) => e.isIntersecting)
            .forEach((e, i) => {
              e.target.style.setProperty("--reveal-delay", `${i * 0.12}s`);
              e.target.classList.add("is-visible");
              io.unobserve(e.target);
            });
        }, { rootMargin: "0px 0px -12% 0px", threshold: 0.15 });
        items.forEach((el) => io.observe(el));
      })();
    </script>
  </body>
</html>

{/*
  define:vars lands as an inline style attribute on <html>, so these become
  real custom properties on :root. Tailwind's @theme maps --color-* onto them,
  which is why nothing below the layout ever names a colour value.
*/}
<style
  define:vars={{
    "theme-background": theme.background,
    "theme-surface": theme.surface,
    "theme-ink": theme.ink,
    "theme-ink-soft": theme.inkSoft,
    "theme-line": theme.line,
    "theme-accent": theme.accent,
    "theme-accent-ink": theme.accentInk,
    "theme-inverted-background": theme.invertedBackground,
    "theme-inverted-ink": theme.invertedInk,
    "theme-inverted-ink-soft": theme.invertedInkSoft,
    "theme-accent-light": theme.accentLight,
  }}
></style>

---
import Base from "../layouts/Base.astro";
import Editorial from "../variants/editorial/Page.astro";
import Studio from "../variants/studio/Page.astro";
import Warm from "../variants/warm/Page.astro";
import { clinic } from "../data/clinic.ts";
import { resolveVariant } from "../data/validate.ts";

// The variant is the only switch in the whole page. PUBLIC_VARIANT wins over
// clinic.ts so the three can be shown to a client over the same data:
//   PUBLIC_VARIANT=studio pnpm dev
const variant = resolveVariant(clinic, import.meta.env.PUBLIC_VARIANT);
const pages = { editorial: Editorial, studio: Studio, warm: Warm };
const Page = pages[variant];
---

<Base clinic={clinic} variant={variant}>
  <Page clinic={clinic} />
</Base>
